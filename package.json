{
  "name": "dsh-queue-withdraw",
  "version": "1.6.1",
  "private": true,
  "description": "Withdraw a queued composer message back into the draft instead of only editing, deleting or steering it.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "queue",
    "composer",
    "withdraw",
    "draft"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzhaos/dsh-queue-withdraw.git"
  },
  "homepage": "https://github.com/tzhaos/dsh-queue-withdraw#readme",
  "bugs": {
    "url": "https://github.com/tzhaos/dsh-queue-withdraw/issues"
  }
}
